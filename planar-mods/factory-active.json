{
  "slots": {
    "areaRender": "area-render",
    "actorRender": "actor-render",
    "pathing": "pathing-astar",
    "populate": "populate",
    "travel": "travel",
    "doors": "doors",
    "collision": "collision"
  },
  "enabled": {
    "area-render": true,
    "actor-render": true,
    "pathing-astar": true,
    "populate": true,
    "travel": true,
    "doors": true,
    "collision": true,
    "paint-cell": false
  },
  "serverHooks": {
    "onAreaLoad": ["populate", "pathing-astar", "travel", "doors", "collision"],
    "onCommand": ["doors", "pathing-astar"],
    "onTick": ["doors", "pathing-astar", "travel"]
  },
  "clientHooks": {
    "onAreaUnload": ["actor-render", "area-render"],
    "onAreaLoad": ["doors", "collision", "area-render", "actor-render", "paint-cell"],
    "onPatches": ["area-render", "actor-render", "collision", "doors"],
    "onFrame": ["area-render", "actor-render", "collision", "paint-cell", "doors"]
  },
  "queries": {
    "floorOverlay": ["doors"]
  }
}
